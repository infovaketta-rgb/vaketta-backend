// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Billing enums ─────────────────────────────────────────────────────────────
// subscriptionStatus was a bare String defaulting to "trial", so nothing at the
// DB level stopped a typo. PAST_DUE is new: it is the grace-period state between
// a missed invoice and full suspension.

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Plan {
  id                      String   @id @default(uuid())
  name                    String
  // ISO 4217, e.g. "USD", "EUR", "INR"
  currency                String   @default("USD")
  // "ALL" = global, else ISO 3166-1 alpha-2. The admin Plans UI has always sent
  // and displayed this field; the column simply never existed, so every plan was
  // silently global and the country picker did nothing.
  country                 String   @default("ALL")
  // All money is INTEGER minor units (cents/paise), e.g. 4900 = $49/mo. These
  // were Float — the original migration created them INTEGER and a later one
  // widened them, which let rounding drift into MRR sums and overage math.
  priceMonthly            Int
  conversationLimit       Int // 0 = unlimited
  aiReplyLimit            Int // 0 = unlimited
  extraConversationCharge Int      @default(0) // minor units per extra conversation
  extraAiReplyCharge      Int      @default(0) // minor units per extra AI reply
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  hotels        Hotel[]
  subscriptions Subscription[]

  @@index([country, isActive])
}

/// The commercial agreement between a hotel and a plan — mutable, with AT MOST
/// ONE live row per hotel (enforced by a partial unique index; see the migration).
/// Periods roll forward in place on renewal; the immutable per-period record is
/// `Invoice`. Superseding a subscription (plan change) marks the old row CANCELED.
///
/// `startDate`/`endDate` keep their column names but now mean the CURRENT period.
/// They used to be back-dated to the start of the calendar month, which is what
/// made a hotel signing up on the 28th expire three days later.
model Subscription {
  id      String  @id @default(uuid())
  hotelId String
  planId  String? // soft ref — plan may be updated later

  status SubscriptionStatus @default(ACTIVE)

  // Snapshot of the plan's terms at assignment time, so editing a Plan never
  // retroactively changes what a hotel is billed for the current period.
  planName                String
  currency                String @default("USD")
  price                   Int // minor units
  conversationLimit       Int
  aiReplyLimit            Int
  extraConversationCharge Int    @default(0) // minor units
  extraAiReplyCharge      Int    @default(0) // minor units

  /// Current period start (inclusive).
  startDate  DateTime
  /// Current period end (exclusive).
  endDate    DateTime?
  autoRenew  Boolean   @default(true)
  canceledAt DateTime?

  /// Day-of-month this subscription recurs on (1–31), in PlatformSettings.billingTimezone.
  ///
  /// STORED, not re-derived from startDate: a short month clamps the period
  /// start (31 Jan → 28 Feb) but must NOT clamp the anchor, or an anchor of 31
  /// would ratchet down to 28 permanently after one February.
  /// Null on pre-anchor rows → derived from the period boundaries at read time,
  /// which reproduces the old calendar-aligned behaviour exactly.
  billingAnchorDay Int?

  /// Plan that takes effect at EXACTLY `endDate` when this is a trial.
  ///
  /// This is what makes trial → paid gapless: the paid period's start IS the
  /// trial's exclusive end, so entitlement is continuous across the boundary
  /// and no background job has to run for the customer to keep working.
  /// Soft reference (like `planId`) — no FK, no second Plan relation.
  scheduledPlanId String?

  // Gateway seam — null while billing is manual. A future Razorpay/Stripe
  // subscription is linked here without a schema change.
  provider               String?
  providerSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel    Hotel     @relation(fields: [hotelId], references: [id])
  plan     Plan?     @relation(fields: [planId], references: [id])
  invoices Invoice[]

  // The table previously had NO indexes at all, so every quota check and every
  // billing read sequentially scanned it.
  @@index([hotelId, status])
  @@index([hotelId, createdAt])
  @@index([status, endDate])
}

/// Immutable per-period billing record. One per hotel per period — the
/// `@@unique([hotelId, periodStart])` is the renewal cron's idempotency key, so
/// a re-run, restart, or concurrent tick can never double-invoice.
model Invoice {
  id             String  @id @default(uuid())
  hotelId        String
  subscriptionId String?

  /// Human-facing sequential reference, e.g. "INV-2026-000042".
  number String        @unique
  status InvoiceStatus @default(OPEN)

  currency     String
  // Integer minor units. total = subtotal + overageTotal.
  subtotal     Int
  overageTotal Int    @default(0)
  total        Int
  amountPaid   Int    @default(0)

  periodStart DateTime
  periodEnd   DateTime
  issuedAt    DateTime  @default(now())
  dueAt       DateTime
  paidAt      DateTime?

  /// [{ kind, description, quantity, unitAmount, amount }] — amounts in minor units.
  lineItems Json
  notes     String?

  // Gateway seam — null while billing is manual.
  provider          String?
  providerInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@unique([hotelId, periodStart])
  @@index([hotelId, issuedAt])
  @@index([status, dueAt])
}

/// A payment against an invoice. Today every row is recorded by hand by a
/// superadmin (`method: "manual_bank_transfer" | "cash"`); `providerPaymentId`
/// is unique so a future gateway webhook is idempotent on retry.
model Payment {
  id        String @id @default(uuid())
  hotelId   String
  invoiceId String

  status   PaymentStatus @default(SUCCEEDED)
  currency String
  amount   Int // minor units
  method   String        @default("manual_bank_transfer")

  provider          String?
  providerPaymentId String? @unique

  /// VakettaAdmin.id for a manually recorded payment; null when gateway-driven.
  recordedByAdminId String?
  reference         String? // bank/UTR reference for manual reconciliation
  notes             String?

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([hotelId, receivedAt])
  @@index([invoiceId])
}

/// Server-side audit trail. Replaces `lib/adminAudit.ts`, which was a
/// `console.info` stub — and which the money-touching actions (assign plan,
/// start trial) never even called, while renaming a hotel did.
///
/// Doubles as the dunning idempotency store: a notice row keyed
/// (hotelId, type, periodEnd) is what stops a restart re-sending an email.
model AuditLog {
  id       String @id @default(uuid())
  category String // "billing" | "hotel" | "admin"
  type     String // "plan.assigned" | "subscription.expired" | "invoice.issued" | …

  actorType String  @default("ADMIN") // "ADMIN" | "SYSTEM"
  actorId   String?
  hotelId   String?

  data Json?

  createdAt DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([category, type, createdAt])
  @@index([createdAt])
}

/// Metered usage for ONE billing period.
///
/// Buckets used to be calendar months, keyed by `month` — so a hotel billed
/// 15 Aug → 14 Sep had its allowance reset on the 1st, halfway through its own
/// cycle, and the renewal invoice read a month that included usage from before
/// the period (trial traffic billed as paid overage). The bucket identity is now
/// `periodStart`, which is exactly the subscription's period boundary.
///
/// `month` is RETAINED and still written (derived from periodStart) because
/// platform-wide analytics genuinely want calendar months. It is no longer
/// unique: a trial and the paid period it converts into can both start in the
/// same calendar month (trial 15 Aug → 29 Aug, paid from 29 Aug), which the old
/// `@@unique([hotelId, month])` would have rejected outright.
model UsageRecord {
  id                String   @id @default(uuid())
  hotelId           String
  month             String // "YYYY-MM" — calendar label for analytics, NOT the identity
  /// Billing-period start (inclusive) — the bucket identity.
  /// Nullable so the migration is additive; backfilled for every existing row.
  periodStart       DateTime?
  /// Billing-period end (exclusive).
  periodEnd         DateTime?
  conversationsUsed Int      @default(0)
  aiRepliesUsed     Int      @default(0)
  updatedAt         DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, periodStart])
  @@index([hotelId, month])
  @@index([month])
}

model Hotel {
  id                 String             @id @default(uuid())
  name               String
  phone              String             @unique // THIS is the tenant key / WhatsApp number
  apiKey             String?            @unique
  // profile fields
  location           String?
  email              String?
  description        String?
  checkInTime        String             @default("14:00")
  checkOutTime       String             @default("11:00")
  website            String?
  // billing
  planId             String?
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  billingStartDate   DateTime?
  billingEndDate     DateTime?

  // WhatsApp Coexistence — chat history sync state
  historySyncStatus    String? // "pending" | "in_progress" | "complete" | "failed"
  historySyncProgress  Int? // 0-100
  historySyncStarted   DateTime?
  historySyncCompleted DateTime?

  createdAt DateTime @default(now())

  guests               Guest[]
  bookings             Booking[]
  messages             Message[]
  roomTypes            RoomType[]
  users                User[]
  conversationSessions ConversationSession[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  payments             Payment[]
  usageRecords         UsageRecord[]
  flowDefinitions      FlowDefinition[]
  inventory            RoomInventory[]
  pushSubscriptions    PushSubscription[]

  plan                     Plan?                     @relation(fields: [planId], references: [id])
  config                   HotelConfig?
  menu                     HotelMenu?
  whatsappTemplates        WhatsAppTemplate[]
  savedReplies             SavedReply[]
  pausedFlows              PausedFlow[]
  confirmationSequences    ConfirmationSequence[]
  templateVariableMappings TemplateVariableMapping[]

  // The expiry/renewal cron sweeps on exactly this pair every 30 min.
  @@index([subscriptionStatus, billingEndDate])
}

model HotelConfig {
  id      String @id @default(uuid())
  hotelId String @unique

  // Locale. The admin hotel-detail page has always PATCHed these three as
  // `config: { country, currency, dateFormat }`, but the columns did not exist
  // and `updateHotelHandler` destructured only { name, phone } — so the whole
  // payload was silently dropped. `country` is also what scopes which Plans a
  // hotel is offered (see Plan.country).
  country    String @default("")
  currency   String @default("INR")
  dateFormat String @default("DD/MM/YYYY")

  autoReplyEnabled    Boolean @default(true)
  bookingEnabled      Boolean @default(true)
  availabilityEnabled Boolean @default(false)
  // Max nights a guest may book in one stay. Gates create_booking BEFORE any
  // availability query — an absurd checkout date (e.g. ~2000 years out) used to
  // OOM the server. Admin-configurable (1–3650); 3650 is a hard crash ceiling.
  maxStayNights       Int     @default(60)
  bookingFlowId       String? // when set, custom flow handles BOOKING menu items
  menuFlowId          String? // when set, this flow IS the main menu (replaces hardcoded buildMenuMessage)
  aiEnabled           Boolean @default(false) // AI fallback for unrecognised guest messages
  businessStartHour   Int     @default(9)
  businessEndHour     Int     @default(21)
  allDay              Boolean @default(false)
  defaultLanguage     String  @default("en")
  timezone            String  @default("UTC")
  welcomeMessage      String  @default("👋 Thanks for contacting us! Our team will assist you shortly.")
  nightMessage        String  @default("🌙 We're currently outside business hours. We'll get back to you when we open!")
  botMessages         Json    @default("{}")
  aiInstructions      String?

  // Hotel-wide age threshold: a child older than this is counted as an adult for
  // occupancy/allocation. Replaces the (now deprecated) per-RoomType childAgeLimit.
  childAgeLimit Int @default(12)

  // Message delay (undo-send)
  messageDelayEnabled Boolean @default(false)
  messageDelaySeconds Int     @default(10) // 1–60

  // WhatsApp / Meta credentials (per-hotel)
  metaPhoneNumberId        String?
  metaAccessTokenEncrypted String? // AES-256-GCM encrypted WhatsApp access token
  metaWabaId               String?
  metaTokenUpdatedAt       DateTime?

  instagramBusinessAccountId String? @unique
  instagramWebhookActive     Boolean @default(false)

  instagramAccessTokenEncrypted String?
  instagramTokenUpdatedAt       DateTime?
  instagramTokenExpiresAt       DateTime?
  facebookPageId                String?
  instagramConnectedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

model HotelMenu {
  id      String @id @default(uuid())
  hotelId String

  title    String  @default("How can we help you?")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel           @relation(fields: [hotelId], references: [id])
  items HotelMenuItem[]

  @@unique([hotelId])
}

model HotelMenuItem {
  id     String @id @default(uuid())
  menuId String

  key       String // "1", "2", "ROOM", etc
  label     String // shown in menu
  replyText String // automated reply / opening message
  type      String          @default("INFO") // INFO | BOOKING | ENQUIRY | FLOW
  order     Int
  isActive  Boolean         @default(true)
  flowId    String?
  flow      FlowDefinition? @relation(fields: [flowId], references: [id], onDelete: SetNull)

  menu HotelMenu @relation(fields: [menuId], references: [id])

  @@index([key])
}

model ConversationSession {
  id        String   @id @default(uuid())
  guestId   String
  hotelId   String
  state     String   @default("IDLE") // IDLE | AWAITING_SELECTION | BOOKING_NAME | BOOKING_ROOM | BOOKING_CHECKIN | BOOKING_CHECKOUT | BOOKING_CONFIRM | ENQUIRY_OPEN
  data      Json     @default("{}") // partial booking data collected so far
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([guestId, hotelId])
  @@index([hotelId, state]) // find all active sessions for a hotel
  @@index([updatedAt]) // session expiry sweep
}

model Guest {
  id        String   @id @default(uuid())
  name      String?
  phone     String
  notes     String?
  isVip     Boolean  @default(false)
  tags      Json     @default("[]")
  createdAt DateTime @default(now())

  lastHandledByStaff Boolean @default(false)

  // Instagram profile enrichment — populated by the instagram-profile worker
  // from the Graph API. `name` above stays STAFF-owned (PATCH /conversations/
  // :guestId) and is never overwritten by Graph data.
  igName             String?
  igUsername         String?
  igProfilePicUrl    String? // OUR mirrored URL (R2 / local) — never a cdninstagram URL (those expire)
  igProfilePicKey    String? // storage key, so the previous object can be deleted
  igProfilePicHash   String? // sha256 of mirrored bytes — skip re-upload when unchanged
  igFollowerCount    Int?
  igFollowsBusiness  Boolean? // is_user_follow_business — guest follows the hotel
  igBusinessFollows  Boolean? // is_business_follow_user — hotel follows the guest
  igProfileFetchedAt DateTime?
  igProfileStatus    String? // OK | NO_CONSENT | NOT_FOUND | TOKEN_EXPIRED | ERROR

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  bookings             Booking[]
  messages             Message[]
  conversationSessions ConversationSession[]
  pausedFlows          PausedFlow[]

  @@unique([phone, hotelId])
  @@index([hotelId, igProfileFetchedAt]) // stale-profile sweeps
}

enum BookingStatus {
  ENQUIRY // bot created, no availability checked, hotel confirms manually
  PENDING // bot created, availability checked & blocked, hotel confirms manually
  HOLD // staff created, availability blocked temporarily
  CONFIRMED // active booking, availability blocked
  CANCELLED // cancelled, availability released
}

model Booking {
  id              String        @id @default(uuid())
  referenceNumber String?       @unique // VKT-YYYY-NNNNN
  guestName       String
  checkIn         DateTime
  checkOut        DateTime
  status          BookingStatus @default(PENDING)

  // 🔑 pricing
  pricePerNight Float // editable override
  advancePaid   Float
  totalPrice    Float

  hotelId    String
  guestId    String
  roomTypeId String

  // Links rooms booked together as one reservation (multi-room allocation).
  // Null = single-room booking.
  bookingGroupId String?

  // Snapshot of watched flow-builder variables captured at create_booking time,
  // so template variables mapped to FLOW_VAR can still resolve after the session
  // (and its transient flowVars) is wiped. Only the names registered in
  // TemplateVariableMapping (sourceType=FLOW_VAR) are persisted here. Null = none.
  flowVars Json?

  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  guest    Guest    @relation(fields: [guestId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  // Per-room detail for multi-room group bookings. Empty for legacy single-room rows.
  rooms BookingRoom[]

  createdAt DateTime @default(now())

  @@index([hotelId, status]) // dashboard + booking list queries
  @@index([hotelId, createdAt]) // dashboard date-range analytics
  @@index([guestId]) // guest booking history
  @@index([checkIn, checkOut]) // availability overlap queries
  @@index([bookingGroupId]) // pull all rooms in a group together
}

model BookingRoom {
  id            String  @id @default(uuid())
  bookingId     String
  roomTypeId    String
  adults        Int     @default(0)
  children      Int     @default(0)
  extraBed      Boolean @default(false)
  pricePerNight Float
  totalPrice    Float

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@index([bookingId])
}

model RoomType {
  id          String   @id @default(uuid())
  name        String
  description String?
  amenities   String[]
  basePrice   Float
  capacity    Int? // total guests (adults + children)
  maxAdults   Int? // max adults allowed
  maxChildren Int? // max children allowed

  // Occupancy pricing rules (used by the advanced_room_allocation flow node).
  // All nullable/defaulted — zero impact on existing rows.
  baseAdults       Int? // adults included in base price (default 2)
  baseChildren     Int? // children included in base price (default 0)
  extraAdultCharge Float? // extra charge per adult per night above baseAdults
  allowExtraBed    Boolean @default(false)
  extraBedCharge   Float? // charge per night for the extra bed
  // childAgeLimit removed — now a single hotel-wide HotelConfig.childAgeLimit.

  totalRooms Int @default(1)

  // Label shown on the WhatsApp carousel "Select Room" button. Max 20 chars
  // (Meta quick_reply.title limit). Falls back to "Select Room" if null.
  carouselButtonLabel String? @default("Select Room")

  hotelId String

  hotel        Hotel           @relation(fields: [hotelId], references: [id])
  bookings     Booking[]
  bookingRooms BookingRoom[]
  photos       RoomPhoto[]
  inventory    RoomInventory[]

  createdAt DateTime @default(now())

  @@index([hotelId])
}

model RoomPhoto {
  id         String   @id @default(uuid())
  url        String
  isMain     Boolean  @default(false)
  order      Int      @default(0)
  roomTypeId String
  createdAt  DateTime @default(now())

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
}

model RoomInventory {
  id             String   @id @default(uuid())
  hotelId        String
  roomTypeId     String
  date           DateTime @db.Date // date-only, stored as UTC midnight
  availableRooms Int // staff-set count for this date (0 = closed)
  price          Float? // null = inherit basePrice from RoomType

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomTypeId, date])
  @@index([hotelId, date])
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  RECEIVED
  FAILED
  READ
}

enum MessageChannel {
  WHATSAPP
  INSTAGRAM
}

model Message {
  id          String   @id @default(uuid())
  direction   String // "IN" | "OUT"
  fromPhone   String
  toPhone     String
  body        String?
  messageType String // text, image, video, audio, document
  mediaUrl    String? // local path served by /uploads or external URL
  mimeType    String? // e.g. "image/jpeg", "video/mp4", "audio/ogg"
  fileName    String? // original filename, used for documents
  wamid       String? // Meta's message ID — used to map status webhooks
  jobId       String? // BullMQ job ID — set when message is queued with a delay (undo-send)
  metadata    Json? // structured extras, e.g. { interactiveReply: { type, id, title } } for WA list/button taps
  timestamp   DateTime @default(now())

  channel MessageChannel @default(WHATSAPP)

  deleted   Boolean   @default(false)
  deletedBy String? // name of the staff member who deleted it
  deletedAt DateTime?

  status MessageStatus @default(PENDING)

  handledAt DateTime?

  hotelId String
  guestId String?

  hotel Hotel  @relation(fields: [hotelId], references: [id])
  guest Guest? @relation(fields: [guestId], references: [id])

  // Composite (not wamid-global) — a wamid is only unique within Meta's scope
  // for one WABA/phone number; the same wamid string could theoretically repeat
  // across different hotels. NULL wamids (staff-composed sends, template sends,
  // etc.) are exempt from Postgres uniqueness — a unique index never treats two
  // NULLs as equal, so non-webhook rows are unaffected. This is what makes the
  // history importer's upsert (history.service.ts) and the live status-webhook
  // dedup both race-safe: DB, not application code, is the source of truth.
  @@unique([hotelId, wamid])
  @@index([wamid]) // status webhook lookup by Meta message ID
  @@index([guestId, timestamp]) // conversation history queries (most common read)
  @@index([hotelId, direction]) // filter IN/OUT per hotel
  @@index([hotelId, channel])
  @@index([fromPhone])
  @@index([toPhone])
  @@index([hotelId])
  @@index([status])
}

// Visual WhatsApp bot conversation flow definition
model FlowDefinition {
  id                 String   @id @default(uuid())
  hotelId            String? // null = global template (Vaketta admin-created)
  name               String
  description        String?
  nodes              Json     @default("[]") // deprecated — use publishedVersion via publishedVersionId
  edges              Json     @default("[]") // deprecated — use publishedVersion via publishedVersionId
  isActive           Boolean  @default(true)
  isTemplate         Boolean  @default(false) // true = global template visible to all hotels
  publishedVersionId String? // soft ref to current published FlowVersion (no FK constraint)
  draftVersionId     String? // soft ref to current draft FlowVersion (no FK constraint)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hotel     Hotel?          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  menuItems HotelMenuItem[]
  versions  FlowVersion[]

  @@index([hotelId])
  @@index([isTemplate])
}

enum FlowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model FlowVersion {
  id            String            @id @default(cuid())
  flowId        String
  versionNumber Int
  nodes         Json
  edges         Json
  status        FlowVersionStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  createdBy     String?

  flow FlowDefinition @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, versionNumber])
  @@index([flowId, status])
}

// Lead capture — submitted from the public landing page
model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  hotelName String
  country   String   @default("")
  planId    String? // which plan they selected on landing page
  message   String?
  status    String   @default("new") // "new" | "contacted" | "converted" | "rejected"
  notes     String? // internal admin notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Platform-wide privacy policy (singleton — only one row ever exists)
model PrivacyPolicy {
  id            String   @id @default("global")
  effectiveDate String   @default("")
  content       String   @default("")
  updatedAt     DateTime @updatedAt
}

// Platform-wide terms of service (singleton)
model TermsOfService {
  id            String   @id @default("global")
  effectiveDate String   @default("")
  content       String   @default("")
  updatedAt     DateTime @updatedAt
}

// Platform-wide data deletion instructions (singleton)
model DataDeletion {
  id            String   @id @default("global")
  effectiveDate String   @default("")
  content       String   @default("")
  updatedAt     DateTime @updatedAt
}

// Platform-wide settings singleton (embed URLs, OAuth config, etc.)
model PlatformSettings {
  id                     String   @id @default("global")
  instagramEmbedUrl      String   @default("")
  whatsappEmbedSignupUrl String   @default("")
  // Meta API version used for all Graph API calls (e.g. "v25.0"). Superadmin-editable
  // so we can bump without a code deploy. Defaults to "v25.0".
  metaApiVersion         String   @default("v25.0")
  // WhatsApp Embedded Signup config_id (extracted from the signup URL, but can be
  // set explicitly so hotel users can connect without the full URL being configured).
  whatsappConfigId       String   @default("")
  // Instagram Facebook-Login-for-Business config_id ("Instagram onboarding"
  // configuration in Meta App Dashboard). Used for the config_id-based FB.login()
  // flow that returns a code (mirrors WhatsApp Embedded Signup). No fallback constant —
  // if empty, the connect flow surfaces a clear error rather than guessing an ID.
  instagramConfigId      String   @default("")
  // Platform-wide max-stay ceiling. The live source of truth for the OOM crash
  // cap — no per-hotel maxStayNights (and no superadmin write) may exceed it.
  // Superadmin-editable. HARD_MAX_STAY_NIGHTS (stayDuration.ts) is the in-code
  // fallback used only if this singleton row is missing.
  maxStayNightsCeiling   Int      @default(3650)
  // The ONE timezone every billing period boundary and UsageRecord month key is
  // derived from. Previously each site built "YYYY-MM" from server-local time,
  // so usage re-bucketed if the container TZ changed and two call sites could
  // disagree. Superadmin-editable; ToS already states prices are in INR.
  billingTimezone        String   @default("Asia/Kolkata")
  // Days after an invoice's due date before a PAST_DUE hotel is suspended.
  gracePeriodDays        Int      @default(7)
  updatedAt              DateTime @updatedAt
}

// Platform-wide trial defaults (singleton — only one row ever exists)
model TrialConfig {
  id                String   @id @default("global") // always "global"
  // Trials are free, so this is cosmetic — but startTrial used to hardcode
  // "USD" onto the snapshot, so a ₹-priced product rendered in dollars on the
  // hotel's Subscription page for the whole trial.
  currency          String   @default("INR")
  durationDays      Int      @default(14)
  conversationLimit Int      @default(500) // 0 = unlimited
  aiReplyLimit      Int      @default(200) // 0 = unlimited
  autoStartOnCreate Boolean  @default(true) // give new hotels a trial immediately
  trialMessage      String   @default("You are on a free trial. Upgrade to a paid plan to continue after the trial ends.")
  updatedAt         DateTime @updatedAt
}

// Vaketta platform-level admins — completely separate from hotel staff
model VakettaAdmin {
  id        String           @id @default(uuid())
  name      String
  email     String           @unique
  password  String
  role      VakettaAdminRole @default(ADMIN)
  createdAt DateTime         @default(now())
}

enum VakettaAdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(STAFF)
  isActive Boolean  @default(true)

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  pushSubscriptions PushSubscription[]
  passwordResetOtps PasswordResetOtp[]

  createdAt DateTime @default(now())
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // bcrypt hash of the 6-digit OTP — never store the raw code
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  hotelId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model WebhookEvent {
  id              String    @id @default(uuid())
  provider        String // instagram
  externalEventId String // mid
  hotelId         String?
  payloadHash     String
  processed       Boolean   @default(false)
  attempts        Int       @default(0)
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([provider, externalEventId])
}

model DeadLetterEvent {
  id       String   @id @default(uuid())
  provider String
  payload  Json
  error    String
  failedAt DateTime @default(now())
  retries  Int      @default(0)
}

// ── WhatsApp Message Templates ────────────────────────────────────────────────

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

model WhatsAppTemplate {
  id      String @id @default(cuid())
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  name            String
  language        String
  category        TemplateCategory
  status          TemplateStatus   @default(PENDING)
  qualityScore    String?
  metaTemplateId  String?
  rejectionReason String?
  components      Json
  variableMapping Json? // e.g. {"1":"guest.name","2":"booking.checkIn"}

  // Header media kept as top-level columns so the send path can include the
  // header component without round-tripping through the JSON blob. headerHandle
  // is the persistent value Meta returns in components[HEADER].example.header_handle[0]
  // after approval; reusable as image/video/document.id at send time.
  headerFormat String? // "IMAGE" | "VIDEO" | "DOCUMENT" | "TEXT" | null
  headerHandle String?

  allowCategoryChange Boolean   @default(true)
  ttlSeconds          Int?
  editCount           Int       @default(0)
  lastEditedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, name, language])
  @@index([hotelId])
}

model SavedReply {
  id        String   @id @default(uuid())
  hotelId   String
  name      String
  category  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

// ── Paused flow resumption ─────────────────────────────────────────────────────
// One record per in-flight delay node. Holds the full flow state so the
// BullMQ resume job can restore execution without touching ConversationSession.
model PausedFlow {
  id        String   @id @default(cuid())
  hotelId   String
  guestId   String
  flowId    String
  nodeId    String // the node AFTER the delay — where execution resumes
  flowVars  Json
  resumeAt  DateTime
  jobId     String? // BullMQ job ID — stored for potential future cancellation
  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, hotelId])
  @@index([resumeAt])
}

// ── Confirmation Sequences ──────────────────────────────────────────────────────
// An ordered list of messages (Templates and/or Saved Replies) a hotel sends when
// staff confirm a booking — replaces the single fixed template/saved-reply selector
// (which remains the legacy fallback). One sequence per (hotel, channel, scope).
// roomTypeScope is a native TEXT[] of RoomType ids; empty = applies to all types.
model ConfirmationSequence {
  id            String   @id @default(uuid())
  hotelId       String
  channel       String // "WHATSAPP" | "INSTAGRAM"
  name          String
  isDefault     Boolean  @default(false)
  roomTypeScope String[] // empty array = applies to all room types
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotel Hotel                      @relation(fields: [hotelId], references: [id])
  steps ConfirmationSequenceStep[]

  @@index([hotelId, channel])
}

model ConfirmationSequenceStep {
  id         String @id @default(uuid())
  sequenceId String
  order      Int
  refType    String // "TEMPLATE" | "SAVED_REPLY"
  refId      String // FK to WhatsAppTemplate.id or SavedReply.id depending on refType

  sequence ConfirmationSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, order])
}

// ── Template variable mapping ────────────────────────────────────────────────────
// One row per mapped {{var}} in a template. Maps the variable to either a fixed
// booking field (BOOKING_FIELD) or a flow-builder variable name (FLOW_VAR) whose
// value is snapshotted onto Booking.flowVars at create_booking time. Unmapped
// variables have no row and fall through to manual staff input.
model TemplateVariableMapping {
  id           String @id @default(uuid())
  hotelId      String
  templateId   String // WhatsAppTemplate.id
  variableName String // the {{var}} name inside the template body
  sourceType   String // "BOOKING_FIELD" | "FLOW_VAR"
  sourceKey    String // booking-field key or flow-var name

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([templateId, variableName])
  @@index([hotelId, templateId])
}
